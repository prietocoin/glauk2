<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-3 md:gap-5">
  
  <!-- BUCLE VINCULADO A ITEMS -->
  <template x-for="(item, index) in items" :key="item.hash_largo || item.hash_corto || index">
    
    <div class="bg-[#060c24] border border-[#16224f] hover:border-cyan-500/40 rounded-2xl p-3 md:p-4 shadow-xl flex flex-col justify-between gap-2.5 transition-all relative">
      <%- include('./cardHeader.ejs') %>
      <%- include('./cardSociosDetalle.ejs') %>
      <%- include('./cardFooterBadges.ejs') %>
    </div>
  </template>

</div>
<!-- TEST DE CONTROL DE MODAL -->
<div x-show="modalAbierto" style="position:fixed; top:20px; right:20px; z-index:99999; background:red; color:white; padding:20px; border-radius:10px;">
  🚨 MODAL PRUEBA ACTIVO
  <button @click="modalAbierto = false" style="background:black; color:white; padding:5px;">Cerrar</button>
</div>
