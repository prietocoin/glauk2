<!-- ================================================================= -->
<!-- COMPONENTE: cardFooterBadges.ejs                                  -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Recibo R2 (60% ancho), badges/metadatos (40%)    -->
<!-- ================================================================= -->

<div class="flex items-stretch gap-2 h-52 sm:h-60 md:h-64">
  
  <!-- VISOR DE IMAGEN R2 (60% de ancho) -->
  <div class="w-[60%] shrink-0 bg-[#010309] border border-blue-900/60 rounded-xl overflow-hidden p-1 flex items-center justify-center relative group">
    <button @click="abrirModalEdicion(item)" class="w-full h-full flex items-center justify-center" title="Ampliar / Auditar recibo">
      <template x-if="item.url_r2 || item.url_imagen">
        <img :src="item.url_r2 || item.url_imagen" class="w-full h-full object-contain rounded-lg opacity-90 group-hover:opacity-100 transition-opacity" alt="Recibo">
      </template>
      <template x-if="!item.url_r2 && !item.url_imagen">
        <span class="text-[9px] text-slate-500 font-bold">📷 SIN IMAGEN</span>
      </template>
    </button>
  </div>

  <!-- METADATOS, BADGES Y BOTONERA (40% restante) -->
  <div class="flex-1 min-w-0 flex flex-col justify-between gap-1 py-0.5">
    
    <!-- 1. 📅 FECHA -->
    <div class="w-full text-center py-0.5 rounded bg-cyan-950/90 text-cyan-300 font-mono text-[8px] sm:text-[9px] font-bold border border-cyan-500/50 shadow truncate px-0.5"
         title="Fecha del comprobante">
      📅 <span x-text="item.fecha_hora_input ? item.fecha_hora_input.substring(0,10) : (item.fecha_hora_comprobante ? item.fecha_hora_comprobante.substring(0,10) : 'S/F')"></span>
    </div>

    <!-- 2. 🕒 DÍA Y HORA -->
    <div class="w-full text-center py-0.5 rounded bg-indigo-950/90 text-indigo-300 font-mono text-[8px] sm:text-[9px] font-bold border border-indigo-500/50 shadow truncate px-0.5"
         title="Día y Hora exacta">
      🕒 <span x-text="typeof formatDiaHora === 'function' ? formatDiaHora(item.fecha_hora_comprobante || item.fecha_hora_input) : 'S/F'"></span>
    </div>

    <!-- 3. 🔑 HASH CORTO -->
    <div class="w-full text-center py-0.5 rounded bg-slate-900/90 text-slate-300 font-mono text-[8px] sm:text-[9px] font-bold border border-slate-700/80 truncate px-0.5 shadow flex items-center justify-center gap-1" 
         title="Hash de verificación">
      <span>🔑</span>
      <span x-text="item.hash_corto || (item.hash_largo ? item.hash_largo.substring(0,8) : 'HASH')"></span>
    </div>
    
    <!-- 4. 🏷️ TIPO OP & BADGE x2 -->
    <div class="flex gap-1 w-full">
      <div class="flex-1 text-center py-0.5 rounded text-[8px] sm:text-[9px] font-bold border whitespace-nowrap truncate px-0.5 flex items-center justify-center gap-0.5" 
           :class="claseInsignia((item.tipo_op_socio || item.tipo_op || item.tipo_manual || 'D').split('-')[0])">
        <span>🏷️</span>
        <span x-text="(item.tipo_op_socio || item.tipo_op || item.tipo_manual || 'D').split('-')[0]"></span>
      </div>
      
      <span x-show="(item.socio_2 || item.nombre_socio_2) && (item.socio_2 || item.nombre_socio_2) !== 'GENERAL' && (item.socio_2 || item.nombre_socio_2) !== 'NO DEFINIDO'" 
            class="px-1 py-0.5 rounded bg-amber-950 text-amber-300 text-[8px] sm:text-[9px] font-bold border border-amber-500/40 whitespace-nowrap">⚡ x2</span>
    </div>

    <!-- 5. 📊 LOTE TASA & STATUS IA -->
    <div class="flex gap-1 w-full">
      <div class="flex-1 text-center py-0.5 rounded bg-purple-950/90 text-purple-300 text-[8px] sm:text-[9px] font-bold border border-purple-500/50 truncate px-0.5 flex items-center justify-center gap-0.5"
           title="Lote de Tasa asignado">
        <span>📊</span>
        <span x-text="item.id_tasa || item.lote_tasa_asignado || item.lote_tasa || 'T-ND'"></span>
      </div>
      
      <span x-show="item.procesado_ia" class="px-1 py-0.5 rounded bg-emerald-950 text-emerald-300 text-[8px] sm:text-[9px] font-bold border border-emerald-500/50 flex items-center justify-center whitespace-nowrap gap-0.5">🤖 IA</span>
    </div>

    <!-- 6. 💰 MONTO EQUIVALENTE 1 Y 2 -->
    <div class="flex flex-col gap-0.5 mt-auto">
      <div class="w-full text-center py-0.5 rounded bg-slate-900/90 text-slate-200 font-mono text-[8px] sm:text-[9px] font-bold border border-slate-700/80 shadow truncate px-0.5 flex items-center justify-between px-1.5" 
           title="Monto Equivalente Socio 1">
        <span class="text-blue-400 font-sans">💳 ME1:</span>
        <span x-text="formatMonto(typeof obtenerME1 === 'function' ? obtenerME1(item) : (item.m1_usdt || item.m1_socio || 0))"></span>
      </div>
      
      <template x-if="(item.socio_2 || item.nombre_socio_2) && (item.socio_2 || item.nombre_socio_2) !== 'GENERAL' && (item.socio_2 || item.nombre_socio_2) !== 'NO DEFINIDO'">
        <div class="w-full text-center py-0.5 rounded bg-slate-900/90 text-slate-200 font-mono text-[8px] sm:text-[9px] font-bold border border-slate-700/80 shadow truncate px-0.5 flex items-center justify-between px-1.5"
             title="Monto Equivalente Socio 2">
          <span class="text-purple-400 font-sans">💳 ME2:</span>
          <span x-text="formatMonto(typeof obtenerME2 === 'function' ? obtenerME2(item) : (item.m2_usdt || item.m2_socio || 0))"></span>
        </div>
      </template>
    </div>

    <!-- 7. 🛠️ ACCIONES DE AUDITORÍA -->
    <div class="flex justify-around items-center pt-1 border-t border-blue-900/40">
      <button @click="eliminarComprobante(item.hash_largo)" class="p-1 text-slate-400 hover:text-rose-400 transition-colors text-sm active:scale-95" title="Eliminar Comprobante">🗑️</button>
      <button @click="abrirModalEdicion(item)" class="p-1 text-slate-400 hover:text-cyan-400 transition-colors text-sm active:scale-95" title="Auditar / Editar">✏️</button>
    </div>

  </div>

</div>
