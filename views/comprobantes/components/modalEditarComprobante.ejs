<!-- COMPONENTE: modalEditarComprobante.ejs                           -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Envoltura modal y orquestador del diálogo         -->
<!-- ================================================================= -->

<!-- views/comprobantes/components/modalEditarComprobante.ejs -->
<div x-show="modalAbierto" 
     class="fixed inset-0 z-50 flex items-center justify-center p-2.5 sm:p-4 bg-black/80 backdrop-blur-md" 
     x-cloak>
  
  <div class="bg-[#080e26] border border-blue-900/80 rounded-2xl w-[95vw] max-w-2xl p-4 sm:p-5 space-y-3.5 shadow-2xl relative max-h-[90vh] overflow-y-auto" 
       @click.away="modalAbierto = false">
    
    <!-- CABECERA -->
    <div class="flex items-center justify-between border-b border-blue-900/60 pb-2.5">
      <span class="text-cyan-400 font-black text-sm sm:text-base flex items-center gap-2">✏️ Auditar & Liquidar Comprobante</span>
      <button type="button" @click="modalAbierto = false" class="text-slate-400 hover:text-white text-base font-bold p-1 transition-colors">✕</button>
    </div>

    <!-- CONTENIDO DEL MODAL -->
    <template x-if="itemEdicion">
      <div class="space-y-3">
        <!-- INCLUSIÓN ATÓMICA DE CAMPOS -->
        <%- include('./modalEditarCampos.ejs') %>

        <!-- BOTONERA DE ACCIONES -->
        <div class="flex flex-wrap justify-between items-center pt-3 border-t border-blue-900/60 gap-2">
          <button type="button" @click="releerIAModal()" class="px-3 py-2 bg-purple-950/80 hover:bg-purple-900 border border-purple-500/50 text-purple-300 rounded-xl font-bold transition-all active:scale-95 flex items-center gap-1.5 text-xs">🤖 Releer IA</button>
          
          <div class="flex gap-2">
            <button type="button" @click="modalAbierto = false" class="px-3.5 py-2 bg-blue-950 hover:bg-blue-900 text-slate-300 rounded-xl font-bold border border-blue-900 transition-colors text-xs">Cancelar</button>
            <button type="button" @click="guardarCambios()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl font-black shadow-lg shadow-cyan-950/50 transition-all active:scale-95 flex items-center gap-1.5 text-xs">💾 Guardar & Congelar</button>
          </div>
        </div>
      </div>
    </template>

  </div>
</div>
