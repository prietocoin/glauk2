<!-- ================================================================= -->
<!-- COMPONENTE UNIFICADO: modalEditarComprobante.ejs                  -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Envoltura, diálogo de edición y campos unificados-->
<!-- ================================================================= -->

<div x-data
     @abrir-modal-edicion.window="abrirModalEdicion($event.detail)">
  
  <template x-teleport="body">
    <div x-show="modalAbierto" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-[99999] flex items-center justify-center p-2.5 sm:p-4 bg-black/80 backdrop-blur-md" 
         x-cloak>
      
      <div class="bg-[#080e26] border border-blue-900/80 rounded-2xl w-[95vw] max-w-2xl p-4 sm:p-5 space-y-3.5 shadow-2xl relative max-h-[90vh] overflow-y-auto" 
           @click.away="modalAbierto = false">
        
        <!-- CABECERA DE MODAL -->
        <div class="flex items-center justify-between border-b border-blue-900/60 pb-2.5">
          <span class="text-cyan-400 font-black text-sm sm:text-base flex items-center gap-2">✏️ Auditar & Liquidar Comprobante</span>
          <button type="button" 
                  @click="modalAbierto = false" 
                  class="text-slate-400 hover:text-white text-base font-bold p-1 transition-colors cursor-pointer">✕</button>
        </div>

        <!-- CUERPO PRINCIPAL DEL MODAL -->
        <template x-if="itemEdicion">
          <div class="space-y-3 text-xs">
            
            <!-- BLOQUE 1: DATOS BANCARIOS Y FECHA/HORA -->
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 bg-[#030611] p-2.5 rounded-xl border border-blue-900/60">
              <div class="sm:col-span-1">
                <label class="block text-[8px] font-bold text-slate-400 uppercase mb-0.5">Banco</label>
                <input type="text" x-model="itemEdicion.banco" placeholder="Ej: BANCOLOMBIA" class="w-full bg-[#080e26] border border-blue-900/80 rounded-lg px-2 py-1.5 text-xs text-white font-bold outline-none uppercase focus:border-cyan-400">
              </div>
              
              <div class="sm:col-span-1">
                <label class="block text-[8px] font-bold text-slate-400 uppercase mb-0.5">Nº Referencia</label>
                <input type="text" x-model="itemEdicion.referencia" placeholder="Ej: 123456" class="w-full bg-[#080e26] border border-blue-900/80 rounded-lg px-2 py-1.5 text-xs text-cyan-300 font-mono font-bold outline-none focus:border-cyan-400">
              </div>

              <div class="sm:col-span-1">
                <label class="block text-[8px] font-bold text-slate-400 uppercase mb-0.5">Titular Cuenta</label>
                <input type="text" x-model="itemEdicion.titular" placeholder="Ej: JUAN PEREZ" class="w-full bg-[#080e26] border border-blue-900/80 rounded-lg px-2 py-1.5 text-xs text-white font-bold outline-none uppercase focus:border-cyan-400">
              </div>

              <div class="sm:col-span-1">
                <label class="block text-[8px] font-bold text-cyan-400 uppercase mb-0.5">📅 Fecha / Hora</label>
                <input type="datetime-local" x-model="itemEdicion.fecha_hora_input" class="w-full bg-[#080e26] border border-cyan-500/40 rounded-lg px-2 py-1.5 text-[11px] text-cyan-300 font-mono font-bold outline-none focus:border-cyan-400">
              </div>
            </div>

            <!-- BLOQUE 2: VALORES FINANCIEROS Y TASA -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 bg-[#030611] p-2.5 rounded-xl border border-blue-900/60">
              <div>
                <label class="block text-[8px] font-bold text-emerald-400 uppercase mb-0.5">Monto Recibo</label>
                <input type="number" step="any" x-model="itemEdicion.monto" class="w-full bg-[#080e26] border border-emerald-500/40 rounded-lg px-2 py-1.5 text-xs text-emerald-300 font-mono font-bold outline-none">
              </div>

              <div>
                <label class="block text-[8px] font-bold text-emerald-400 uppercase mb-0.5">Moneda</label>
                <select x-model="itemEdicion.moneda" class="w-full bg-[#080e26] border border-emerald-500/40 rounded-lg px-2 py-1.5 text-xs text-white font-bold outline-none">
                  <template x-for="m in ['COP','USD','USDT','VES','ARS','PEN','CLP']" :key="m">
                    <option :value="m" x-text="m"></option>
                  </template>
                </select>
              </div>

              <div>
                <label class="block text-[8px] font-bold text-purple-400 uppercase mb-0.5">Lote Tasa</label>
                <input type="text" x-model="itemEdicion.lote_tasa_asignado" placeholder="T052" class="w-full bg-[#080e26] border border-purple-500/40 rounded-lg px-2 py-1.5 text-xs text-purple-300 font-mono font-bold outline-none uppercase">
              </div>

              <div>
                <label class="block text-[8px] font-bold text-amber-400 uppercase mb-0.5">Operación</label>
                <select x-model="itemEdicion.tipo_manual" class="w-full bg-[#080e26] border border-amber-500/40 rounded-lg px-2 py-1.5 text-xs text-white font-bold outline-none">
                  <option value="D">D (Depósito)</option>
                  <option value="P">P (Pago)</option>
                  <option value="A">A (Abono)</option>
                </select>
              </div>
            </div>

            <!-- BLOQUE 3: ASIGNACIÓN DE SOCIOS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="block text-[9px] font-bold text-cyan-400 uppercase mb-0.5">Socio 1 (Impacto)</label>
                <select x-model="itemEdicion.nombre_socio_1" class="w-full bg-[#030611] border border-cyan-500/40 rounded-xl px-2 py-1.5 text-xs text-white font-bold outline-none">
                  <option value="GENERAL">GENERAL</option>
                  <template x-for="s in (directorio || [])" :key="'ed-s1-'+(s.nombre || s)">
                    <option :value="s.nombre || s" x-text="s.nombre || s"></option>
                  </template>
                </select>
              </div>

              <div>
                <label class="block text-[9px] font-bold text-pink-400 uppercase mb-0.5">Socio 2 (Contraparte)</label>
                <select x-model="itemEdicion.nombre_socio_2" class="w-full bg-[#030611] border border-pink-500/40 rounded-xl px-2 py-1.5 text-xs text-white font-bold outline-none">
                  <option value="GENERAL">GENERAL</option>
                  <template x-for="s in (directorio || [])" :key="'ed-s2-'+(s.nombre || s)">
                    <option :value="s.nombre || s" x-text="s.nombre || s"></option>
                  </template>
                </select>
              </div>
            </div>

            <!-- BOTONERA DE ACCIONES -->
            <div class="flex flex-wrap justify-between items-center pt-3 border-t border-blue-900/60 gap-2">
              <button type="button" @click="releerIAModal()" class="px-3 py-2 bg-purple-950/80 hover:bg-purple-900 border border-purple-500/50 text-purple-300 rounded-xl font-bold transition-all active:scale-95 flex items-center gap-1.5 text-xs cursor-pointer">🤖 Releer IA</button>
              
              <div class="flex gap-2">
                <button type="button" @click="modalAbierto = false" class="px-3.5 py-2 bg-blue-950 hover:bg-blue-900 text-slate-300 rounded-xl font-bold border border-blue-900 transition-colors text-xs cursor-pointer">Cancelar</button>
                <button type="button" @click="guardarCambios ? guardarCambios() : guardarEdicionComprobante()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl font-black shadow-lg shadow-cyan-950/50 transition-all active:scale-95 flex items-center gap-1.5 text-xs cursor-pointer">💾 Guardar & Congelar</button>
              </div>
            </div>

          </div>
        </template>

      </div>
    </div>
  </template>
</div>
