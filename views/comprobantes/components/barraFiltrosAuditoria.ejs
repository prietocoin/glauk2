<!-- ================================================================= -->
<!-- COMPONENTE: barraFiltrosAuditoria.ejs                             -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Panel de 8 filtros reactivos para la auditoría   -->
<!-- ================================================================= -->

<div x-data="{ filtrosAbiertos: false }" class="bg-[#060c24] rounded-2xl border border-blue-900/50 shadow-xl overflow-hidden">
  
  <!-- BOTÓN MÓVIL (Toggle) -->
  <button @click="filtrosAbiertos = !filtrosAbiertos" class="w-full md:hidden flex items-center justify-between p-3 bg-[#080e26] text-xs font-bold text-cyan-300">
    <span class="flex items-center gap-2">🔍 Filtros de Auditoría <span x-text="filtrosAbiertos ? '(Ocultar)' : '(Desplegar)'" class="text-[10px] text-slate-400 font-normal"></span></span>
    <span x-text="filtrosAbiertos ? '▲' : '▼'"></span>
  </button>

  <!-- GRILLA DE 8 FILTROS -->
  <div :class="filtrosAbiertos ? 'block' : 'hidden md:grid'" class="p-3 grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-2.5 items-end">
    
    <div>
      <label class="block text-[9px] font-bold text-cyan-400 uppercase mb-1">1. ROL</label>
      <select x-model="filtroRol" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
        <option value="">Todos</option><option value="SOCIO">SOCIOS</option><option value="MATRIZ_GENERAL">MATRIZ_GENERAL</option><option value="MATRIZ_1">MATRIZ_1</option>
      </select>
    </div>

    <div>
      <label class="block text-[9px] font-bold text-cyan-400 uppercase mb-1">2. SOCIO</label>
      <select x-model="filtroSocio" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
        <option value="">Todos</option>
        <template x-for="s in directorio" :key="'fs-'+(s.nombre || s)"><option :value="s.nombre || s" x-text="s.nombre || s"></option></template>
      </select>
    </div>

    <div>
      <label class="block text-[9px] font-bold text-slate-400 uppercase mb-1">3. INICIO</label>
      <input type="date" x-model="filtroFechaInicio" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
    </div>

    <div>
      <label class="block text-[9px] font-bold text-slate-400 uppercase mb-1">4. FIN</label>
      <input type="date" x-model="filtroFechaFin" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
    </div>

    <div>
      <label class="block text-[9px] font-bold text-amber-400 uppercase mb-1">5. DESDE HASH</label>
      <select x-model="filtroDesdeHash" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-amber-500/40 rounded-lg px-2 py-1.5 text-xs text-amber-200 outline-none focus:border-amber-400">
        <option value="">TODOS</option>
        <template x-for="item in comprobantes" :key="'dh-'+(item.hash_largo || item.hash_corto)"><option :value="item.hash_largo" x-text="item.hash_corto || (item.hash_largo ? item.hash_largo.substring(0,8) : 'HASH')"></option></template>
      </select>
    </div>

    <div>
      <label class="block text-[9px] font-bold text-amber-400 uppercase mb-1">6. HASTA HASH</label>
      <select x-model="filtroHastaHash" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-amber-500/40 rounded-lg px-2 py-1.5 text-xs text-amber-200 outline-none focus:border-amber-400">
        <option value="">TODOS</option>
        <template x-for="item in comprobantes" :key="'hh-'+(item.hash_largo || item.hash_corto)"><option :value="item.hash_largo" x-text="item.hash_corto || (item.hash_largo ? item.hash_largo.substring(0,8) : 'HASH')"></option></template>
      </select>
    </div>

    <div>
      <label class="block text-[9px] font-bold text-cyan-400 uppercase mb-1">7. ORDENAR</label>
      <select x-model="filtroOrden" @change="cargarComprobantes()" class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
        <option value="fecha_desc">Recientes primero</option><option value="fecha_asc">Antiguos primero</option><option value="monto_desc">Mayor Monto</option><option value="monto_asc">Menor Monto</option>
      </select>
    </div>

    <div class="col-span-2 md:col-span-1">
      <label class="block text-[9px] font-bold text-cyan-400 uppercase mb-1">8. BUSCAR HASH</label>
      <input type="text" x-model="filtroHash" @keyup.enter="cargarComprobantes()" placeholder="Buscar..." class="w-full bg-[#030611] border border-blue-900/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 outline-none focus:border-cyan-400">
    </div>

  </div>
</div>
