<!-- ================================================================= -->
<!-- COMPONENTE: cardSociosDetalle.ejs                                 -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Muestra Socio 1, Socio 2, Tasas y Montos con Color de Polaridad -->
<!-- ================================================================= -->

<div class="bg-[#030611] rounded-xl border border-blue-900/50 p-2 space-y-1">
  
  <!-- SOCIO 1 (Impacto Primario - Color Cian) -->
  <div class="grid grid-cols-12 items-center text-xs gap-1"
       x-data="{ 
         s1Nombre: item.socio_1 || item.nombre_socio_1 || item.socio || item.titular || 'GENERAL',
         get s1Badge() {
           if (item.badge_1) return item.badge_1;
           const rol = (item.rol_1 || (directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(this.s1Nombre).trim().toUpperCase())?.rol || '').toUpperCase();
           if (rol === 'ADMIN') return '💎';
           if (rol === 'ASESOR') return '👔';
           if (rol === 'PROVEEDOR') return '🏦';
           return '🤝';
         },
         get s1Moneda() {
           if (item.moneda_base_socio1) return item.moneda_base_socio1;
           const sObj = (directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(this.s1Nombre).trim().toUpperCase());
           return sObj?.moneda_base || sObj?.moneda_socio || sObj?.moneda || 'USDT';
         },
         get s1Polaridad() {
           return item.polaridad_1 || item.grupo_1?.polaridad || '+';
         }
       }">
    
    <!-- Nombre limpio con Micro-Insignia -->
    <div class="col-span-4 flex items-center gap-1 min-w-0">
      <span class="text-[10px] shrink-0 select-none" x-text="s1Badge"></span>
      <span class="font-black text-cyan-300 uppercase truncate text-[11px]" 
            x-text="((directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(s1Nombre).trim().toUpperCase())?.herencia ? '↳ ' : '') + s1Nombre"></span>
    </div>
    
    <!-- Tasa 1 procesada -->
    <div class="col-span-3 text-center">
      <span class="px-1 py-0.5 rounded bg-purple-950/80 text-purple-300 text-[8px] md:text-[9px] font-mono border border-purple-500/30 whitespace-nowrap" 
            x-text="'T1: ' + formatTasa(obtenerTasaSocioCalculada(item, 1))"></span>
    </div>

    <!-- Monto Socio 1: Color y Signo según Polaridad (+ Verde / - Magenta) -->
    <span class="col-span-5 font-mono font-bold text-right truncate text-[11px]" 
          :class="s1Polaridad === '-' ? 'text-pink-400' : 'text-emerald-400'"
          x-text="(s1Polaridad === '-' ? '- ' : '') + formatMonto(Math.abs(parseFloat(obtenerME1(item)))) + ' ' + s1Moneda"></span>
  </div>
  
  <!-- SOCIO 2 (Contraparte - Color Rosa) -->
  <template x-if="(item.socio_2 || item.nombre_socio_2) && (item.socio_2 || item.nombre_socio_2) !== 'GENERAL' && (item.socio_2 || item.nombre_socio_2) !== 'NO DEFINIDO'">
    <div class="grid grid-cols-12 items-center text-xs gap-1 border-t border-blue-900/40 pt-1"
         x-data="{ 
           s2Nombre: item.socio_2 || item.nombre_socio_2,
           get s2Badge() {
             if (item.badge_2) return item.badge_2;
             const rol = (item.rol_2 || (directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(this.s2Nombre).trim().toUpperCase())?.rol || '').toUpperCase();
             if (rol === 'ADMIN') return '💎';
             if (rol === 'ASESOR') return '👔';
             if (rol === 'PROVEEDOR') return '🏦';
             return '🤝';
           },
           get s2Moneda() {
             if (item.moneda_base_socio2) return item.moneda_base_socio2;
             const sObj = (directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(this.s2Nombre).trim().toUpperCase());
             return sObj?.moneda_base || sObj?.moneda_socio || sObj?.moneda || 'USDT';
           },
           get s2Polaridad() {
             return item.polaridad_2 || item.grupo_2?.polaridad || '-';
           }
         }">
      
      <!-- Nombre limpio con Micro-Insignia -->
      <div class="col-span-4 flex items-center gap-1 min-w-0">
        <span class="text-[10px] shrink-0 select-none" x-text="s2Badge"></span>
        <span class="font-black text-pink-300 uppercase truncate text-[11px]" 
              x-text="((directorio || []).find(d => String(d.nombre || '').trim().toUpperCase() === String(s2Nombre).trim().toUpperCase())?.herencia ? '↳ ' : '') + s2Nombre"></span>
      </div>
      
      <!-- Tasa 2 procesada -->
      <div class="col-span-3 text-center">
        <span class="px-1 py-0.5 rounded bg-purple-950/80 text-purple-300 text-[8px] md:text-[9px] font-mono border border-purple-500/30 whitespace-nowrap" 
              x-text="'T2: ' + formatTasa(obtenerTasaSocioCalculada(item, 2))"></span>
      </div>

      <!-- Monto Socio 2: Color y Signo según Polaridad (+ Verde / - Magenta) -->
      <span class="col-span-5 font-mono font-bold text-right truncate text-[11px]" 
            :class="s2Polaridad === '-' ? 'text-pink-400' : 'text-emerald-400'"
            x-text="(s2Polaridad === '-' ? '- ' : '') + formatMonto(Math.abs(parseFloat(obtenerME2(item)))) + ' ' + s2Moneda"></span>
    </div>
  </template>

</div>
