<!-- ================================================================= -->
<!-- COMPONENTE: cardHeader.ejs                                        -->
<!-- UBICACIÓN: views/comprobantes/components/                         -->
<!-- RESPONSABILIDAD: Cabecera limpia RAW (Monto + Banco/Titular/Ref)  -->
<!-- ================================================================= -->

<div class="flex items-start justify-between gap-2 border-b border-slate-800/80 pb-2.5">
  
  <!-- LADO IZQUIERDO: MONTO PRINCIPAL Y DIVISA -->
  <div class="flex items-baseline gap-1.5 min-w-0">
    <span class="text-xl md:text-2xl font-black text-emerald-400 tracking-tight" x-text="formatMonto(item.monto)"></span>
    <span class="text-xs font-bold text-slate-200 uppercase" x-text="item.moneda || '---'"></span>
  </div>

  <!-- LADO DERECHO: METADATOS BANCARIOS RAW -->
  <div class="flex flex-col items-end text-right shrink-0 min-w-0 leading-tight text-[10px]">
    <span class="font-black text-slate-200 uppercase truncate max-w-[150px]" x-text="item.titular || '-'"></span>
    <span class="text-[9px] font-semibold text-slate-400 uppercase truncate" x-text="item.banco || '-'"></span>
    <div class="flex items-center gap-1 text-[9px] font-mono mt-0.5">
      <span class="text-slate-500 font-bold">Ref:</span>
      <span class="text-cyan-400 font-bold" x-text="item.referencia || '-'"></span>
    </div>
  </div>

</div>
