<!-- ================================================================= -->
<!-- COMPONENTE: sidebar.ejs                                           -->
<!-- UBICACIÓN: views/layout/                                          -->
<!-- RESPONSABILIDAD: Menú lateral de navegación global y Modales      -->
<!-- ================================================================= -->

<aside class="w-full md:w-64 bg-[#070e23] border-r border-slate-800 flex flex-col justify-between shrink-0" x-data="{ modalTasas: false, modalPerfiles: false }">
  <div class="p-4 space-y-6">
    <!-- LOGO -->
    <div class="flex items-center gap-3">
      <img src="/logo-fundablock.png" alt="Logo" class="h-9 w-auto">
      <div>
        <h1 class="font-bold text-white text-sm tracking-wide">FUNDABLOCK</h1>
        <p class="text-[10px] text-cyan-400 font-mono">GLAUK2 ENGINE</p>
      </div>
    </div>

    <!-- MENÚ DE NAVEGACIÓN -->
    <nav class="space-y-1">
      
      <!-- 1. COMPROBANTES -->
      <button @click="vistaActiva = 'comprobantes'" :class="vistaActiva === 'comprobantes' ? 'bg-cyan-500/10 text-cyan-400 border-l-2 border-cyan-400' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200'" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-r text-sm font-medium transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Comprobantes
      </button>

      <!-- 2. CARTELERA TASAS (Modal Iframe TasasHub) -->
      <button @click="modalTasas = true" class="w-full flex items-center justify-between px-3 py-2.5 rounded-r text-sm font-medium transition text-slate-400 hover:bg-slate-800/50 hover:text-slate-200">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          Cartelera Tasas
        </div>
        <span class="text-xs text-sky-400 opacity-80 font-normal">↗</span>
      </button>

      <!-- 3. DIRECTORIO SOCIOS (Modal Iframe PerfilHub) -->
      <button @click="modalPerfiles = true" class="w-full flex items-center justify-between px-3 py-2.5 rounded-r text-sm font-medium transition text-slate-400 hover:bg-slate-800/50 hover:text-slate-200">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          Directorio Socios
        </div>
        <span class="text-xs text-cyan-400 opacity-80 font-normal">↗</span>
      </button>

      <!-- 4. DASHBOARD -->
      <button @click="vistaActiva = 'dashboard'" :class="vistaActiva === 'dashboard' ? 'bg-cyan-500/10 text-cyan-400 border-l-2 border-cyan-400' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200'" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-r text-sm font-medium transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Dashboard
      </button>

    </nav>
  </div>

  <div class="p-4 border-t border-slate-800/80">
    <div class="text-xs text-slate-500 font-mono text-center">
      Glauk2 Engine &bull; Online
    </div>
  </div>

  <!-- MODAL IFRAME: TasasHub Engine -->
  <template x-teleport="body">
    <div 
      @keydown.escape.window="modalTasas = false"
      x-show="modalTasas" 
      x-cloak
      class="fixed inset-0 z-[100] flex items-center justify-center bg-[#070b14]/90 backdrop-blur-md p-4">
      
      <div 
        @click.outside="modalTasas = false"
        class="relative w-full h-[95vh] max-w-[1400px] bg-[#0b1329] border border-cyan-500/40 rounded-xl shadow-2xl flex flex-col overflow-hidden ring-1 ring-cyan-500/10">
        
        <div class="flex items-center justify-between px-5 py-3 border-b border-cyan-500/20 bg-slate-900/95 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 drop-shadow-md">⚡</span>
            <span class="text-sm font-bold text-slate-100 tracking-wide">TasasHub Engine</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-bold border border-emerald-500/20 ml-2">LIVE</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="https://tasas.jairokov.com" target="_blank" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
              Abrir en pestaña ↗
            </a>
            <button @click="modalTasas = false" class="text-slate-400 hover:text-white px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 hover:shadow-lg text-xs font-bold transition-all border border-slate-700/50">
              ✕ ESC
            </button>
          </div>
        </div>

        <div class="flex-1 w-full h-full bg-[#050811] relative">
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none" x-show="modalTasas">
            <div class="animate-pulse text-cyan-500/50 text-sm font-semibold tracking-widest">Iniciando TasasHub...</div>
          </div>
          
          <template x-if="modalTasas">
            <iframe 
              src="https://tasas.jairokov.com?embed=true" 
              class="absolute inset-0 w-full h-full border-0 z-10 rounded-b-xl"
              loading="lazy">
            </iframe>
          </template>
        </div>
      </div>
    </div>
  </template>

  <!-- MODAL IFRAME: PerfilHub Engine (Directorio Socios) -->
  <template x-teleport="body">
    <div 
      @keydown.escape.window="modalPerfiles = false"
      x-show="modalPerfiles" 
      x-cloak
      class="fixed inset-0 z-[100] flex items-center justify-center bg-[#070b14]/90 backdrop-blur-md p-4">
      
      <div 
        @click.outside="modalPerfiles = false"
        class="relative w-full h-[95vh] max-w-[1400px] bg-[#0b1329] border border-cyan-500/40 rounded-xl shadow-2xl flex flex-col overflow-hidden ring-1 ring-cyan-500/10">
        
        <div class="flex items-center justify-between px-5 py-3 border-b border-cyan-500/20 bg-slate-900/95 shadow-sm">
          <div class="flex items-center gap-2">
            <span class="text-cyan-400">👤</span>
            <span class="text-sm font-bold text-slate-100 tracking-wide">PerfilHub Engine</span>
            <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 text-[10px] font-bold border border-cyan-500/30 ml-2">DIRECTORIO</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="https://perfiles.jairokov.com" target="_blank" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
              Abrir en pestaña ↗
            </a>
            <button @click="modalPerfiles = false" class="text-slate-400 hover:text-white px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 hover:shadow-lg text-xs font-bold transition-all border border-slate-700/50">
              ✕ ESC
            </button>
          </div>
        </div>

        <div class="flex-1 w-full h-full bg-[#050811] relative">
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none" x-show="modalPerfiles">
            <div class="animate-pulse text-cyan-500/50 text-sm font-semibold tracking-widest">Iniciando PerfilHub...</div>
          </div>
          
          <template x-if="modalPerfiles">
            <iframe 
              src="https://perfiles.jairokov.com" 
              class="absolute inset-0 w-full h-full border-0 z-10 rounded-b-xl"
              loading="lazy">
            </iframe>
          </template>
        </div>
      </div>
    </div>
  </template>

</aside>
