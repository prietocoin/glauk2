<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Fundablock - Glauk2 Engine</title>

  <!-- PWA Y CONFIGURACIÓN TEMÁTICA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#030611">

  <link rel="icon" type="image/png" href="/logo-fundablock.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: { 
            glaukov: { 
              bg: '#030611', card: '#060c24', border: '#16224f', 
              blue: '#2563eb', neon: '#06b6d4', pink: '#ec4899', green: '#10b981'
            } 
          }
        }
      }
    }
  </script>

  <!-- CLIENTE MODULAR Y ALPINE.JS -->
  <script type="module" src="/js/appBootstrap.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    [x-cloak] { display: none !important; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #030611; }
    ::-webkit-scrollbar-thumb { background: #16224f; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #2563eb; }
    input, select, textarea { font-size: 14px !important; }

    @media print {
      body * { visibility: hidden; }
      #reporte-html-documento, #reporte-html-documento * { visibility: visible; }
      #reporte-html-documento { position: absolute; left: 0; top: 0; width: 100%; background: #ffffff !important; color: #000000 !important; }
      .no-imprimir { display: none !important; }
    }
  </style>
</head>

<body class="bg-[#030611] text-slate-100 font-sans antialiased min-h-screen selection:bg-cyan-500 selection:text-black" 
      x-data="app" 
      x-cloak>

  <!-- CONTENEDOR FIJO DE PANTALLA COMPLETA -->
  <div class="flex flex-col md:flex-row h-screen overflow-hidden">
    
    <!-- NAVEGACIÓN LATERAL PRINCIPAL -->
    <%- include('./layout/sidebar.ejs') %>

    <!-- ÁREA DE CONTENIDO DINÁMICO -->
    <main class="flex-1 p-3 md:p-6 overflow-y-auto overflow-x-hidden space-y-4 md:space-y-5">
      
      <!-- VISTA 1: AUDITORÍA DE COMPROBANTES -->
      <div x-show="vistaActiva === 'comprobantes'" class="space-y-3 md:space-y-4">
        <%- include('./comprobantes/components/headerKPIs.ejs') %>
        <%- include('./comprobantes/components/barraFiltrosAuditoria.ejs') %>
        <%- include('./comprobantes/components/listaComprobantesCards.ejs') %>
      </div>

      <!-- VISTA 2: CARTELERA DE TASAS -->
      <div x-show="vistaActiva === 'cartelera'" class="space-y-4">
        <%- include('./tasas/components/gestionTasas.ejs') %>
      </div>

      <!-- VISTA 3: DIRECTORIO DE SOCIOS -->
      <div x-show="vistaActiva === 'directorio'" class="space-y-4">
        <%- include('./directorio/components/directorioLista.ejs') %>
      </div>

      <!-- VISTA 4: DASHBOARD -->
      <div x-show="vistaActiva === 'dashboard'" class="space-y-4">
        <%- include('./dashboard/components/balancePendientes.ejs') %>
        <%- include('./dashboard/components/inspeccionLotes.ejs') %>
      </div>

    </main>
  </div>

  <!-- COMPONENTES MODALES FLOTANTES -->
  <%- include('./directorio/components/modalConfigSocio.ejs') %>
  <%- include('./comprobantes/components/modalEditarComprobante.ejs') %>
  <%- include('./reportes/components/modalReporteEstadoCuenta.ejs') %>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch((err) => {
          console.warn('Error al registrar Service Worker PWA:', err);
        });
      });
    }
  </script>
</body>
</html>
